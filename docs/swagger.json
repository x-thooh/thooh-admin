{
    "swagger": "2.0",
    "info": {
        "description": "基于Go，gin，JWT，vue前后端分离的权限管理系统",
        "title": "thooh-go 接口文档",
        "contact": {
            "name": "thooh-go",
            "url": "https://gitee.com/thooh/thooh-go"
        },
        "version": "v1.0.2"
    },
    "host": "127.0.0.1:8080",
    "basePath": "/",
    "paths": {
        "/auth/code": {
            "get": {
                "tags": [
                    "auth"
                ],
                "summary": "登录验证码",
                "responses": {
                    "200": {
                        "description": "成功",
                        "schema": {
                            "$ref": "#/definitions/r.R"
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "账号密码登录",
                "parameters": [
                    {
                        "description": "登录参数",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.LoginBo"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "schema": {
                            "$ref": "#/definitions/r.R"
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "退出登录",
                "responses": {
                    "200": {
                        "description": "成功",
                        "schema": {
                            "$ref": "#/definitions/r.R"
                        }
                    }
                }
            }
        },
        "/getInfo": {
            "get": {
                "tags": [
                    "auth"
                ],
                "summary": "当前用户信息",
                "responses": {
                    "200": {
                        "description": "成功",
                        "schema": {
                            "$ref": "#/definitions/r.R"
                        }
                    }
                }
            }
        },
        "/getRouters": {
            "get": {
                "tags": [
                    "auth"
                ],
                "summary": "当前用户路由",
                "responses": {
                    "200": {
                        "description": "成功",
                        "schema": {
                            "$ref": "#/definitions/r.R"
                        }
                    }
                }
            }
        },
        "/sys/user": {
            "get": {
                "tags": [
                    "user"
                ],
                "summary": "用户列表",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "页码",
                        "name": "pageNum",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "每页条数",
                        "name": "pageSize",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "schema": {
                            "$ref": "#/definitions/r.R"
                        }
                    }
                }
            },
            "put": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user"
                ],
                "summary": "更新用户",
                "parameters": [
                    {
                        "description": "用户",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/user.SysUser"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "schema": {
                            "$ref": "#/definitions/r.R"
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user"
                ],
                "summary": "新增用户",
                "parameters": [
                    {
                        "description": "用户",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/user.SysUser"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "schema": {
                            "$ref": "#/definitions/r.R"
                        }
                    }
                }
            }
        },
        "/sys/user/info/{id}": {
            "get": {
                "tags": [
                    "user"
                ],
                "summary": "用户详情",
                "parameters": [
                    {
                        "type": "string",
                        "description": "用户ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "schema": {
                            "$ref": "#/definitions/r.R"
                        }
                    }
                }
            }
        },
        "/sys/user/{ids}": {
            "delete": {
                "tags": [
                    "user"
                ],
                "summary": "删除用户",
                "parameters": [
                    {
                        "type": "string",
                        "description": "用户ID，逗号分隔",
                        "name": "ids",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "schema": {
                            "$ref": "#/definitions/r.R"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.LoginBo": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                },
                "uuid": {
                    "type": "string"
                }
            }
        },
        "r.R": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {},
                "msg": {
                    "type": "string"
                }
            }
        },
        "user.SysUser": {
            "type": "object",
            "properties": {
                "avatar": {
                    "description": "头像URL",
                    "type": "string"
                },
                "avtag": {
                    "description": "可用标记",
                    "type": "boolean"
                },
                "catag": {
                    "description": "缓存标记",
                    "type": "boolean"
                },
                "crtim": {
                    "description": "创建时间",
                    "type": "string"
                },
                "cruid": {
                    "description": "创建人ID",
                    "type": "string"
                },
                "email": {
                    "description": "邮箱",
                    "type": "string"
                },
                "gender": {
                    "description": "性别",
                    "type": "string"
                },
                "id": {
                    "description": "主键ID",
                    "type": "string"
                },
                "job": {
                    "description": "职务",
                    "type": "string"
                },
                "label": {
                    "description": "标签",
                    "type": "string"
                },
                "loip": {
                    "description": "登录IP",
                    "type": "string"
                },
                "lotim": {
                    "description": "登录时间",
                    "type": "string"
                },
                "monum": {
                    "description": "手机号",
                    "type": "string"
                },
                "name": {
                    "description": "名称",
                    "type": "string"
                },
                "notes": {
                    "description": "备注",
                    "type": "string"
                },
                "orgid": {
                    "description": "部门ID",
                    "type": "string"
                },
                "orgna": {
                    "description": "部门名称",
                    "type": "string"
                },
                "ornum": {
                    "description": "排序号",
                    "type": "integer"
                },
                "password": {
                    "description": "口令（散列）；出站置空后 omitempty 让字段不再出现",
                    "type": "string"
                },
                "tier": {
                    "description": "层级,以“_”隔开",
                    "type": "string"
                },
                "type": {
                    "description": "用户类型",
                    "type": "integer"
                },
                "uptim": {
                    "description": "更新时间",
                    "type": "string"
                },
                "upuid": {
                    "description": "更新人ID",
                    "type": "string"
                },
                "username": {
                    "description": "用户名（账号）",
                    "type": "string"
                }
            }
        }
    }
}