{
  "go_src": ".",
  "go_version_min": "1.25",
  "go_env": {
    "GOPROXY": "https://goproxy.cn,direct"
  },
  "agents_max_lines": 150,
  "sub_agents_max_lines": 80,
  "subject_max_chars": 50,
  "budget": {
    "scopes": 300,
    "scripts": 300,
    "shared": 420,
    "corpus": 500
  },
  "slow_scopes": [
    "build"
  ],
  "module_roots": [
    "modules",
    "admin"
  ],
  "registry_file": "app/admin/router.go",
  "web_index": "web/admin/index.html",
  "swagger_json": "docs/swagger.json",
  "swagger_yaml": "docs/swagger.yaml",
  "stale_days_warn": 7,
  "stale_days_error": 14,
  "board_stale_days": 30,
  "worktree_done_days": 7,
  "rules_version": "1"
}
