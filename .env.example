# 复制成 .env 再填值：cp .env.example .env
#
# .env 被 .gitignore 的 `.*` 排除，不会入库；docker compose 会从项目目录自动读它。
# 空值 = 没给。带「必填」的两条不给时 compose 直接拒绝启动并点名，应用也会同样退出——
# 这是刻意的：私有化交付里「起不来并说清缺什么」比「带着默认弱口令起来」好。
#
# 必填（生成：openssl rand -base64 24 / 48；换 JWT 密钥会让现存 token 全部失效）
THOOH_DB_PW=
THOOH_JWT_SECRET=

# 可选（取消注释即覆盖默认值；默认值在 docker-compose.yml 与 config.yaml 里）
# THOOH_DB_HOST=mysql
# THOOH_DB_PORT=3306
# THOOH_DB_NAME=thooh-go
# THOOH_DB_USER=root
# THOOH_REDIS_HOST=redis
# THOOH_REDIS_PORT=6379
# THOOH_REDIS_PW=
# THOOH_PUBLIC_PORT=8080
# THOOH_RUN_MODE=release
# THOOH_LOG_LEVEL=info
